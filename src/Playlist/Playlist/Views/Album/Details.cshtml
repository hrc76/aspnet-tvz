@model Album

@{
    ViewData["Title"] = Model.Title;
    string coverName = Model.Title.Replace(" ", "") + ".jpg";
}


<section class="record-detail-hero">
    <div class="record-cover-wrap">
        <img src="~/images/albums/@coverName"
             alt="@Model.Title cover"
             onerror="this.src='/images/albums/placeholder.jpg'" />
    </div>

    <div class="record-info">
        <p class="mb-eyebrow">Album</p>
        <h1>@Model.Title</h1>

        <p class="record-artist">
            by
            <a asp-controller="Artist" asp-action="Details" asp-route-id="@Model.Artist.ArtistId">
                @Model.Artist.StageName
            </a>
        </p>

        <div class="record-meta-row">
            <span>@Model.ReleaseDate.Year</span>
            <span>@Model.Label</span>
            <span>@Model.TotalTracks tracks</span>
            <span>@Model.Rating ★</span>
        </div>

        <div class="record-actions">
            <button type="button" class="mb-btn mb-btn-primary">
                    Play Album
            </button>
            @if (ViewBag.IsSaved == true)
{
    <form asp-controller="SavedAlbum" asp-action="Remove" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="albumId" value="@Model.AlbumId" />

        <button type="submit" class="mb-btn mb-btn-danger">
            Remove from Library
        </button>
    </form>
}
else
{
    <form asp-controller="SavedAlbum" asp-action="Add" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="albumId" value="@Model.AlbumId" />

        <button type="submit" class="mb-btn mb-btn-ghost">
            Save to Library
        </button>
    </form>
}
        </div>
    </div>
</section>

<section class="record-tracklist">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Tracklist</p>
            <h2>Songs on this album</h2>
        </div>
    </div>

    @if (Model.Songs != null && Model.Songs.Any())
    {
        <div class="tracklist">
            @{
                var index = 1;
            }

            @foreach (var song in Model.Songs)
            {
                <a asp-controller="Song"
                   asp-action="Details"
                   asp-route-id="@song.SongId"
                   class="track-row">
                    <span class="track-number">@index</span>

                    <div class="track-main">
                        <h3>@song.Title</h3>
                        <p>@song.Artist.StageName · @song.Genre.Name</p>
                    </div>

                    <span class="track-duration">@song.Duration</span>
                </a>

                index++;
            }
        </div>
    }
    else
    {
        <p>No songs available for this album.</p>
    }
</section>

<p class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="mb-btn mb-btn-ghost">Home</a>
    <a asp-controller="Library" asp-action="Index" class="mb-btn mb-btn-ghost">Library</a>
    <a asp-controller="Discover" asp-action="Index" class="mb-btn mb-btn-ghost">Discover</a>
</p>