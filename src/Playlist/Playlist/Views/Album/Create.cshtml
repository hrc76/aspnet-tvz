@model Album
@using Playlist.Models

@{
    ViewData["Title"] = "Add Album";
    var artists = ViewBag.Artists as List<Artist>;
}

<div class="admin-page">
<aside class="admin-aside">
    <div class="admin-aside-card">
        <div class="admin-aside-icon">💿</div>
        <h3>New Album</h3>
        <p>Add a release to the catalogue. Songs can be linked to this album through the Song editor.</p>
    </div>
    <nav class="admin-aside-links">
        <a asp-action="Index">← All Albums</a>
        <a asp-controller="Artist" asp-action="Create">+ New Artist</a>
        <a asp-controller="Song" asp-action="Create">+ New Song</a>
    </nav>
</aside>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="account-form crud-form fade-in-form">
    @Html.AntiForgeryToken()

    <div class="form-row-2">
        <div class="form-group">
            <label asp-for="Title">Album Title</label>
            <input asp-for="Title" class="mb-input" placeholder="Album name" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ArtistId">Artist</label>
            <select asp-for="ArtistId" class="mb-input">
                <option value="">— select artist —</option>
                @foreach (var a in artists ?? new List<Artist>())
                {
                    <option value="@a.ArtistId">@a.StageName</option>
                }
            </select>
            <span asp-validation-for="ArtistId" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row-2">
        <div class="form-group">
            <label asp-for="Label">Label</label>
            <input asp-for="Label" class="mb-input" placeholder="Record label" />
            <span asp-validation-for="Label" class="text-danger"></span>
        </div>

        <div class="form-group">
            @{
                var releaseDateStr = Model.ReleaseDate == default ? "" : Model.ReleaseDate.ToString("dd.MM.yyyy");
            }
            @await Html.PartialAsync("_DateTimePicker", releaseDateStr,
                new ViewDataDictionary(ViewData) { { "Label", "Release Date" }, { "Name", "ReleaseDateInput" } })
            <input type="hidden" asp-for="ReleaseDate" id="ReleaseDateHidden" />
        </div>
    </div>

    <div class="form-row-2">
        <div class="form-group">
            <label asp-for="TotalTracks">Total Tracks</label>
            <input asp-for="TotalTracks" type="number" min="0" max="500" class="mb-input" placeholder="0" />
            <span asp-validation-for="TotalTracks" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Rating">Rating (0.0 – 5.0)</label>
            <input asp-for="Rating" type="number" min="0" max="5" step="0.1" class="mb-input" placeholder="0.0" />
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group image-upload-field">
        <label for="coverImage">Album cover</label>
        <input id="coverImage" name="coverImage" type="file"
               accept="image/jpeg,image/png,image/webp" class="mb-input" />
        <span class="text-danger">@Html.ValidationMessage("coverImage")</span>
        <small>Optional JPG, PNG or WebP image, maximum 5 MB.</small>
    </div>

    <div class="playlist-create-actions">
        <button type="submit" class="mb-btn mb-btn-primary">Add Album</button>
        <a asp-action="Index" class="mb-btn mb-btn-ghost">Cancel</a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $(".js-datepicker").on("change", function () {
                if ($(this).attr("name") === "ReleaseDateInput") {
                    $("#ReleaseDateHidden").val($(this).val());
                }
            });
        });
    </script>
}
