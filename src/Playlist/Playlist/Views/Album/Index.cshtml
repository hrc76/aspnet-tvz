@model List<Album>

<section class="page-hero compact-hero">
    <p class="eyebrow">Library shelf</p>
    <h1>Albums</h1>
    <p>Browse releases, labels and ratings from the collection.</p>
</section>

<section class="entity-grid">
    @foreach (var album in Model)
    {
        <article class="entity-card">
            <div class="entity-card-top">
                <span class="entity-type">Album</span>
                <span class="rating-pill">@album.Rating ★</span>
            </div>

            <h2>@album.Title</h2>

            <div class="entity-meta">
                <span>@album.Artist.StageName</span>
                <span>@album.ReleaseDate.ToShortDateString()</span>
                <span>@album.Label</span>
            </div>

            <div class="entity-footer">
                <span>@album.TotalTracks tracks</span>
                <a asp-controller="Album" asp-action="Details" asp-route-id="@album.AlbumId" class="btn btn-outline">
                    Open Album
                </a>
            </div>
        </article>
    }
</section>