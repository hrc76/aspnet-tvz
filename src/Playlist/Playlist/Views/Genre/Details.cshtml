@model Genre
@using System.Text.Json

@{
    ViewData["Title"] = Model.Name;

    string SongJson(Song s) => JsonSerializer.Serialize(new {
        id         = s.SongId,
        title      = s.Title,
        artist     = s.Artist?.StageName ?? "",
        audioUrl   = s.AudioUrl ?? "",
        coverColor = "#ff8a1f"
    });

    var queueJson = Model.Songs != null && Model.Songs.Any()
        ? JsonSerializer.Serialize(Model.Songs.Select(s => new {
            id         = s.SongId,
            title      = s.Title,
            artist     = s.Artist?.StageName ?? "",
            audioUrl   = s.AudioUrl ?? "",
            coverColor = "#ff8a1f"
          }))
        : "[]";
}

<section class="genre-zone-hero">
    <div>
        <p class="mb-eyebrow">Sound zone</p>
        <h1>@Model.Name</h1>
        <p>@Model.Description</p>
        @if (Model.Songs != null && Model.Songs.Any())
        {
            <button type="button" class="mb-btn mb-btn-primary js-play-all-btn mt-3" data-queue="@queueJson">
                <span class="eq-bars" style="margin-right:0.25rem"><span></span><span></span><span></span><span></span></span>
                ▶ Play All
            </button>
        }
    </div>

    <div class="genre-stats-card">
        <span>@(Model.Songs?.Count ?? 0)</span>
        <p>songs in this sound zone</p>
    </div>
</section>

<section class="genre-mood-board">
    <article>
        <span>Library mood</span>
        <h2>Raw sound selection</h2>
        <p>This genre page collects tracks, artists and records connected through the same sound identity.</p>
    </article>
    <article>
        <span>Discovery path</span>
        <h2>Start with the tracks</h2>
        <p>Click the play button for a 30-second preview, or click the card to open song details.</p>
    </article>
</section>

<section class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Tracks</p>
            <h2>@Model.Name Songs</h2>
        </div>
    </div>

    @if (Model.Songs != null && Model.Songs.Any())
    {
        <div class="genre-track-grid">
            @foreach (var song in Model.Songs)
            {
                <a asp-controller="Song" asp-action="Details" asp-route-id="@song.SongId" class="genre-track-card">
                    <button type="button" class="js-play-btn genre-track-icon" data-song="@SongJson(song)">▶</button>
                    <div>
                        <h3>@song.Title</h3>
                        <p>@song.Artist.StageName</p>
                    </div>
                    <span>@song.Duration</span>
                    <button type="button" class="queue-add-btn js-queue-btn" data-song="@SongJson(song)" title="Add @song.Title to queue">+Q</button>
                </a>
            }
        </div>
    }
    else
    {
        <p class="mb-muted">No songs available for this genre.</p>
    }
</section>

<div class="details-actions mt-4">
    <a asp-action="Edit" asp-route-id="@Model.GenreId" class="mb-btn mb-btn-secondary">Edit Genre</a>
    <form asp-action="Delete" asp-route-id="@Model.GenreId" method="post" class="inline-form">
        @Html.AntiForgeryToken()
        <button type="submit" class="mb-btn mb-btn-danger"
                onclick="return confirm('Delete genre?')">Delete Genre</button>
    </form>
    <a asp-action="Index" class="mb-btn mb-btn-ghost">All Genres</a>
    <a asp-controller="Home" asp-action="Index" class="mb-btn mb-btn-ghost">Home</a>
</div>
