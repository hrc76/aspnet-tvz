@model User
@using System.Text.Json

@{
    ViewData["Title"] = "Account";
    var profileImageUrl = ViewBag.ProfileImageUrl as string;
    var profileMessage = ViewBag.ProfileMessage as string;

    string SongJson(Song s) => JsonSerializer.Serialize(new {
        id         = s.SongId,
        title      = s.Title,
        artist     = s.Artist?.StageName ?? "",
        audioUrl   = s.AudioUrl ?? "",
        coverColor = "#ff8a1f"
    });
}

<section class="artist-profile-hero account-profile-hero">
    <div class="profile-avatar-panel">
        <div class="artist-avatar profile-avatar">
            @if (!string.IsNullOrWhiteSpace(profileImageUrl))
            {
                <img src="@profileImageUrl" alt="@Model.Username profile image" />
            }
            else
            {
                <span>@Model.Username.Substring(0, 1).ToUpper()</span>
            }
        </div>
        <form asp-action="UploadProfileImage" method="post" enctype="multipart/form-data" class="profile-image-form">
            @Html.AntiForgeryToken()
            <label class="profile-image-picker">
                <input type="file" name="profileImage" accept="image/jpeg,image/png,image/webp" />
                <span>Choose image</span>
            </label>
            <button type="submit" class="mb-btn mb-btn-secondary btn-sm">Upload</button>
        </form>
        <small>JPG, PNG or WebP, up to 5 MB.</small>
    </div>
    <div class="artist-profile-info">
        <p class="mb-eyebrow">Signed in</p>
        <h1>
            @Model.Username
            @if (Model.IsPremium)
            {
                <span class="premium-badge">Premium</span>
            }
        </h1>
        <form asp-action="UpdateProfileName" method="post" class="profile-name-form">
            @Html.AntiForgeryToken()
            <label for="profileDisplayName">Display name</label>
            <div class="profile-name-controls">
                <input id="profileDisplayName"
                       name="Username"
                       value="@Model.Username"
                       minlength="2"
                       maxlength="100"
                       autocomplete="nickname"
                       required />
                <button type="submit" class="mb-btn mb-btn-secondary btn-sm">Save name</button>
            </div>
            <small>Your email stays unchanged and is still used for sign in.</small>
        </form>
        <div class="artist-meta-row">
            <span>@Model.Email</span>
            <span>Joined @Model.RegistrationDate.ToString("dd.MM.yyyy")</span>
            <span>Fav. genre: @Model.FavoriteGenreName</span>
            <span>@(Model.IsPremium ? "Premium" : "Free") account</span>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(profileMessage))
{
    <div class="profile-message">@profileMessage</div>
}

<section class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Your playlists</p>
            <h2>Playlists</h2>
        </div>
        <a asp-controller="Playlist" asp-action="Create" class="mb-btn mb-btn-primary">+ New Playlist</a>
    </div>

    @if (Model.Playlists != null && Model.Playlists.Any())
    {
        <div class="library-grid">
            @foreach (var playlist in Model.Playlists)
            {
                int ph = ((playlist.Name.GetHashCode() % 360) + 360) % 360;
                string pGrad = $"linear-gradient(135deg, hsl({ph},62%,20%), hsl({(ph + 45) % 360},55%,12%))";
                <a asp-controller="Playlist"
                   asp-action="Details"
                   asp-route-id="@playlist.PlaylistId"
                   class="library-card">
                    <div class="album-cover-wrap" style="background:@pGrad">
                        <span class="album-cover-letter">@playlist.Name.Substring(0, 1).ToUpper()</span>
                    </div>
                    <div class="library-card-body">
                        <span class="library-type">Playlist</span>
                        <h3>@playlist.Name</h3>
                        <p>@playlist.Description</p>
                        <small>@(playlist.IsPublic ? "Public" : "Private")</small>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <p class="mb-muted">No playlists yet.</p>
    }
</section>

<section class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Listening activity</p>
            <h2>Recently Played</h2>
        </div>
    </div>

    @if (Model.ListeningHistory != null && Model.ListeningHistory.Any())
    {
        <div class="mb-song-list">
            @foreach (var history in Model.ListeningHistory)
            {
                <article class="track-row" data-song-id="@history.Song.SongId">
                    <div class="track-num-play">
                        <span class="eq-bars"><span></span><span></span><span></span><span></span></span>
                        <button type="button" class="js-play-btn track-play-btn" data-song="@SongJson(history.Song)">▶</button>
                    </div>
                    <div class="track-main">
                        <h3>
                            <a asp-controller="Song" asp-action="Details" asp-route-id="@history.Song.SongId" class="track-details-link">
                                @history.Song.Title
                            </a>
                        </h3>
                        <p>@history.Song.Artist.StageName · listened @history.ListenedAt</p>
                    </div>
                    <span class="track-duration">@history.Repeats× played</span>
                </article>
            }
        </div>
    }
    else
    {
        <p class="mb-muted">No listening history yet.</p>
    }
</section>
