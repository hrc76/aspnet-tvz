@model global::Playlist.Controllers.LoginViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Login";
    var googleEnabled = !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"]) &&
                        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]);
}

<div class="auth-page">
    @if (ViewBag.RequiresAuthentication == true)
    {
        <div class="auth-access-notice" role="alert">
            <span class="auth-access-notice-icon" aria-hidden="true">!</span>
            <div>
                <strong>Sign in required</strong>
                <p>You need to sign in before opening that page.</p>
            </div>
        </div>
    }
    <section class="auth-intro">
        <p class="mb-eyebrow">Welcome back</p>
        <h1>Return to your music.</h1>
        <p>Sign in to manage your library, playlists and listening activity.</p>
        <div class="auth-visual" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
        </div>
    </section>

    <form asp-action="Login" method="post" class="account-form auth-form">
        <div class="auth-form-heading">
            <span>MusicBar account</span>
            <h2>Login</h2>
            <p>Enter your account details below.</p>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="mb-input" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="mb-input" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <label class="auth-remember">
            <input asp-for="RememberMe" />
            <span>Keep me signed in</span>
        </label>

        <button type="submit" class="mb-btn mb-btn-primary auth-submit">Log in</button>
        <div class="auth-divider"><span>or</span></div>

        @if (googleEnabled)
        {
            <a asp-action="ExternalLogin" asp-route-provider="Google" class="mb-btn mb-btn-secondary auth-google">Continue with Google</a>
        }
        else
        {
            <p class="auth-provider-note">Google login is currently unavailable.</p>
        }

        <p class="auth-switch">New to MusicBar? <a asp-action="Register">Create an account</a></p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
