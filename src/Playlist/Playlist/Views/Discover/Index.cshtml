@using Playlist.Models

@{
    ViewData["Title"] = "Discover";

    var songs = ViewBag.Songs as List<Song>;
    var artists = ViewBag.Artists as List<Artist>;
    var albums = ViewBag.Albums as List<Album>;
    var genres = ViewBag.Genres as List<Genre>;

    string CoverName(string title) => title.Replace(" ", "") + ".jpg";
}

<section class="discover-hero">
    <p class="mb-eyebrow">Find new sounds</p>
    <h1>Discover / Search</h1>
    <p>Search songs, explore genres and find records from your music vault.</p>

    <div class="discover-search">
        <input id="discoverSearch"
               type="text"
               class="mb-input"
               placeholder="Search songs, artists, albums..." />

        <button class="mb-btn mb-btn-primary">
            Search
        </button>
    </div>

    <div id="discoverResults" class="ajax-results"></div>
</section>

<section class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Genre lanes</p>
            <h2>Explore by Sound</h2>
        </div>
    </div>

    <div class="discover-genre-grid">
        @if (genres != null)
        {
            foreach (var genre in genres)
            {
                <a asp-controller="Genre"
                   asp-action="Details"
                   asp-route-id="@genre.GenreId"
                   class="discover-genre-card">

                    <span>@genre.Name</span>
                    <p>@genre.Description</p>
                </a>
            }
        }
    </div>
</section>

<section class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Recommended</p>
            <h2>High Energy Picks</h2>
        </div>
    </div>

    <div class="mb-song-list">
        @if (songs != null)
        {
            foreach (var song in songs)
            {
                <article class="mb-song-row">
                    <div class="mb-play-dot">▶</div>

                    <div>
                        <h3>@song.Title</h3>
                        <p>@song.Artist.StageName · @song.Genre.Name · @song.Mood</p>
                    </div>

                    <span>@song.PopularityScore score</span>

                    <a asp-controller="Song"
                       asp-action="Details"
                       asp-route-id="@song.SongId">
                        Open
                    </a>
                </article>
            }
        }
    </div>
</section>

<section class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Records to open</p>
            <h2>Top Rated Albums</h2>
        </div>
    </div>

    <div class="mb-album-grid">
        @if (albums != null)
        {
            foreach (var album in albums)
            {
                <a asp-controller="Album"
                   asp-action="Details"
                   asp-route-id="@album.AlbumId"
                   class="mb-album-card">

                    <img src="~/images/albums/@CoverName(album.Title)"
                         alt="@album.Title cover"
                         onerror="this.src='/images/albums/placeholder.jpg'" />

                    <h3>@album.Title</h3>
                    <p>@album.Artist.StageName</p>
                    <span>@album.Rating ★</span>
                </a>
            }
        }
    </div>
</section>

<section class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Artist radar</p>
            <h2>Artists to Explore</h2>
        </div>
    </div>

    <div class="mb-mini-grid discover-artists">
        @if (artists != null)
        {
            foreach (var artist in artists)
            {
                <a asp-controller="Artist"
                   asp-action="Details"
                   asp-route-id="@artist.ArtistId"
                   class="mb-mini-card">

                    <h3>@artist.StageName</h3>
                    <p>@artist.Country · @(artist.IsActive ? "Active" : "Inactive")</p>
                </a>
            }
        }
    </div>
</section>

@section Scripts {
    <script>
        $(function () {

            $("#discoverSearch").on("keyup", function () {

                const term = $(this).val();

                if (term.length < 2) {
                    $("#discoverResults").empty();
                    return;
                }

                $.ajax({
                    url: "/Discover/Search",
                    method: "GET",
                    data: { term: term },

                    success: function (data) {

                        let html = "";

                        data.forEach(function (item) {

                            html += `
                                <a class="ajax-result-item" href="${item.url}">
                                    <strong>${item.title}</strong>
                                    <span>${item.subtitle}</span>
                                </a>
                            `;
                        });

                        $("#discoverResults").html(html);
                    }
                });
            });

        });
    </script>
}