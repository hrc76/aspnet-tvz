@model Song
@using Playlist.Models

@{
    ViewData["Title"] = "Add Song";
    var artists = ViewBag.Artists as List<Artist>;
    var albums  = ViewBag.Albums  as List<Album>;
    var genres  = ViewBag.Genres  as List<Genre>;
    var moods   = ViewBag.Moods   as List<MoodType>;
}

<div class="admin-page">
    <aside class="admin-aside">
        <div class="admin-aside-card">
            <div class="admin-aside-icon">🎵</div>
            <h3>New Track</h3>
            <p>Add a song to the catalogue. Link it to an existing artist, album and genre. The player automatically fetches Deezer previews so the audio URL is optional.</p>
        </div>
        <nav class="admin-aside-links">
            <a asp-controller="Song" asp-action="Index">← All Songs</a>
            <a asp-controller="Artist" asp-action="Create">+ New Artist</a>
            <a asp-controller="Album" asp-action="Create">+ New Album</a>
        </nav>
    </aside>

    <form asp-action="Create" method="post" class="account-form crud-form fade-in-form">
        @Html.AntiForgeryToken()

        <p class="form-section-label">Basic info</p>

        <div class="form-group">
            <label asp-for="Title">Title</label>
            <input asp-for="Title" class="mb-input" placeholder="Song title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label asp-for="ArtistId">Artist</label>
                <select asp-for="ArtistId" class="mb-input">
                    <option value="">— select artist —</option>
                    @foreach (var a in artists ?? new List<Artist>())
                    {
                        <option value="@a.ArtistId">@a.StageName</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="AlbumId">Album</label>
                <select asp-for="AlbumId" class="mb-input">
                    <option value="">— select album —</option>
                    @foreach (var a in albums ?? new List<Album>())
                    {
                        <option value="@a.AlbumId">@a.Title</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label asp-for="GenreId">Genre</label>
                <select asp-for="GenreId" class="mb-input">
                    <option value="">— select genre —</option>
                    @foreach (var g in genres ?? new List<Genre>())
                    {
                        <option value="@g.GenreId">@g.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Mood">Mood</label>
                <select asp-for="Mood" class="mb-input">
                    @foreach (var m in moods ?? new List<MoodType>())
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-section">
            <p class="form-section-label">Timing &amp; Stats</p>
            <div class="form-row-2">
                <div class="form-group">
                    <label for="DurationInput">Duration (mm:ss)</label>
                    <input type="text" id="DurationInput" name="DurationInput" class="mb-input" placeholder="3:45" />
                    <input type="hidden" asp-for="Duration" id="DurationHidden" />
                </div>
                <div class="form-group">
                    @{
                        var releaseDateStr = Model.ReleaseDate == default ? "" : Model.ReleaseDate.ToString("dd.MM.yyyy");
                    }
                    @await Html.PartialAsync("_DateTimePicker", releaseDateStr,
                        new ViewDataDictionary(ViewData) { { "Label", "Release Date" }, { "Name", "ReleaseDateInput" } })
                    <input type="hidden" asp-for="ReleaseDate" id="ReleaseDateHidden" />
                </div>
            </div>
            <div class="form-row-2">
                <div class="form-group">
                    <label asp-for="PlayCount">Play Count</label>
                    <input asp-for="PlayCount" type="number" min="0" class="mb-input" placeholder="0" />
                </div>
                <div class="form-group">
                    <label asp-for="PopularityScore">Popularity (0–100)</label>
                    <input asp-for="PopularityScore" type="number" min="0" max="100" step="0.1" class="mb-input" placeholder="75" />
                </div>
            </div>
        </div>

        <div class="form-section">
            <p class="form-section-label">Flags</p>
            <div class="playlist-visibility-box">
                <label class="mb-checkbox">
                    <input asp-for="IsExplicit" />
                    <div><strong>Explicit content</strong><p>Song contains explicit lyrics.</p></div>
                </label>
            </div>
        </div>

        <div class="playlist-create-actions">
            <button type="submit" class="mb-btn mb-btn-primary">Add Song</button>
            <a asp-action="Index" class="mb-btn mb-btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $("form").on("submit", function () {
                var raw = $("#DurationInput").val().trim();
                var parts = raw.split(":");
                var m = parseInt(parts[0]) || 0;
                var s = parseInt(parts[1]) || 0;
                $("#DurationHidden").val("00:" + String(m).padStart(2, "0") + ":" + String(s).padStart(2, "0"));
            });
            $(".js-datepicker").on("change", function () {
                if ($(this).attr("name") === "ReleaseDateInput") $("#ReleaseDateHidden").val($(this).val());
            });
        });
    </script>
}
