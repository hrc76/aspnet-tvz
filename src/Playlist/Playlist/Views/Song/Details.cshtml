@model Song

@{
    ViewData["Title"] = Model.Title;
    string coverName = Model.Album.Title.Replace(" ", "") + ".jpg";
}

<section class="song-player-hero">
    <div class="song-cover">
        <img src="~/images/albums/@coverName"
             alt="@Model.Album.Title cover"
             onerror="this.src='/images/albums/placeholder.jpg'" />
    </div>

    <div class="song-player-info">
        <p class="mb-eyebrow">Now playing</p>
        <h1>@Model.Title</h1>

        <p class="song-byline">
            by
            <a asp-controller="Artist" asp-action="Details" asp-route-id="@Model.Artist.ArtistId">
                @Model.Artist.StageName
            </a>
            from
            <a asp-controller="Album" asp-action="Details" asp-route-id="@Model.Album.AlbumId">
                @Model.Album.Title
            </a>
        </p>

        <div class="song-meta-row">
            <span>@Model.Genre.Name</span>
            <span>@Model.Mood</span>
            <span>@Model.Duration</span>
            <span>@Model.PlayCount plays</span>
            <span>@Model.PopularityScore score</span>
            <span>@(Model.IsExplicit ? "Explicit" : "Clean")</span>
        </div>

        <div class="fake-audio-player">
            <button type="button">▶</button>
            <div class="fake-wave">
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
            </div>
            <small>@Model.Duration</small>
        </div>

        <div class="record-actions">
            @if (ViewBag.IsFavorite == true)
            {
                <form asp-controller="Favorite" asp-action="Remove" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="songId" value="@Model.SongId" />

                    <button type="submit" class="mb-btn mb-btn-danger">
                        Remove Favorite
                    </button>
                </form>
            }
            else
            {
                <form asp-controller="Favorite" asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="songId" value="@Model.SongId" />

                    <button type="submit" class="mb-btn mb-btn-primary">
                        Add to Favorites
                    </button>
                </form>
            }

            <form asp-controller="Playlist"
                  asp-action="AddSong"
                  method="post"
                  class="playlist-add-form autocomplete-form">
                @Html.AntiForgeryToken()

                <input type="hidden" name="songId" value="@Model.SongId" />
                <input type="hidden" name="playlistId" id="selectedPlaylistId" />

                <div class="autocomplete-box">
                    <label>Add to playlist</label>

                    <input id="playlistAutocomplete"
                           type="text"
                           class="mb-input"
                           placeholder="Search playlist..." />

                    <div id="playlistAutocompleteResults" class="autocomplete-results"></div>
                </div>

                <button type="submit" class="mb-btn mb-btn-primary">
                    Add to Playlist
                </button>
            </form>
        </div>
    </div>
</section>

<section class="song-context-grid">
    <article class="song-context-card">
        <p class="mb-eyebrow">Artist</p>
        <h2>@Model.Artist.StageName</h2>
        <p>@Model.Artist.Country · @(Model.Artist.IsActive ? "Active" : "Inactive")</p>
        <a asp-controller="Artist" asp-action="Details" asp-route-id="@Model.Artist.ArtistId">
            Open artist page
        </a>
    </article>

    <article class="song-context-card">
        <p class="mb-eyebrow">Album</p>
        <h2>@Model.Album.Title</h2>
        <p>@Model.Album.ReleaseDate.Year · @Model.Album.Label · @Model.Album.Rating ★</p>
        <a asp-controller="Album" asp-action="Details" asp-route-id="@Model.Album.AlbumId">
            Open album
        </a>
    </article>

    <article class="song-context-card">
        <p class="mb-eyebrow">Genre</p>
        <h2>@Model.Genre.Name</h2>
        <p>@Model.Genre.Description</p>
        <a asp-controller="Genre" asp-action="Details" asp-route-id="@Model.Genre.GenreId">
            Explore genre
        </a>
    </article>
</section>

<p class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="mb-btn mb-btn-ghost">Home</a>
    <a asp-controller="Library" asp-action="Index" class="mb-btn mb-btn-ghost">Library</a>
    <a asp-controller="Discover" asp-action="Index" class="mb-btn mb-btn-ghost">Discover</a>
</p>

@section Scripts {
    <script>
        $(function () {
            $("#playlistAutocomplete").on("input", function () {
                const term = $(this).val();

                if (term.length < 1) {
                    $("#playlistAutocompleteResults").empty();
                    $("#selectedPlaylistId").val("");
                    return;
                }

                $.ajax({
                    url: "/Playlist/SearchUserPlaylists",
                    method: "GET",
                    data: { term: term },
                    success: function (data) {
                        let html = "";

                        data.forEach(function (item) {
                            html += `
                                <button type="button"
                                        class="autocomplete-item"
                                        data-id="${item.id}"
                                        data-text="${item.text}">
                                    <strong>${item.text}</strong>
                                    <span>${item.subtitle}</span>
                                </button>`;
                        });

                        $("#playlistAutocompleteResults").html(html);
                    }
                });
            });

            $(document).on("click", ".autocomplete-item", function () {
                const id = $(this).data("id");
                const text = $(this).data("text");

                $("#selectedPlaylistId").val(id);
                $("#playlistAutocomplete").val(text);
                $("#playlistAutocompleteResults").empty();
            });

            $(".autocomplete-form").on("submit", function (e) {
                if (!$("#selectedPlaylistId").val()) {
                    e.preventDefault();
                    alert("Please select a playlist first.");
                }
            });
        });
    </script>
}