@using Playlist.ViewModels
@model LibraryViewModel

@{
    ViewData["Title"] = "Library";
}

<section class="library-hero">
    <p class="mb-eyebrow">Your collection</p>
    <h1>Library</h1>
    <p>Favorite songs, saved albums and playlists in one place.</p>

   <div class="library-tools">
    <input id="librarySearch" type="text" placeholder="Search your library..." />

    <button type="button" class="library-filter active" data-type="all">All</button>
    <button type="button" class="library-filter" data-type="albums">Albums</button>
    <button type="button" class="library-filter" data-type="playlists">Playlists</button>
</div>
</section>

<section id="favoriteSongsSection" class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Pinned tracks</p>
            <h2>Favorite Songs</h2>
        </div>
    </div>

    <div class="mb-song-list">
        @foreach (var song in Model.FavoriteSongs)
        {
            <article class="mb-song-row">
                <div class="mb-play-dot">▶</div>

                <div>
                    <h3>@song.Title</h3>
                    <p>@song.Artist.StageName · @song.Genre.Name · @song.Duration</p>
                </div>

                <span>@song.PlayCount plays</span>

                <a asp-controller="Song" asp-action="Details" asp-route-id="@song.SongId">
                    Listen
                </a>
            </article>
        }
    </div>
</section>

<section id="libraryResultsSection" class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Saved items</p>
            <h2>Albums & Playlists</h2>
        </div>

        <a asp-controller="Playlist" asp-action="Create">+ Create Playlist</a>
    </div>

    <div id="libraryGrid" class="library-grid">
        @foreach (var item in Model.LibraryItems)
        {
            <a asp-controller="@item.ControllerName"
               asp-action="Details"
               asp-route-id="@item.Id"
               class="library-card">

                <img src="@item.ImagePath"
                     alt="@item.Title"
                     onerror="this.src='/images/albums/placeholder.jpg'" />

                <div class="library-card-body">
                    <span class="library-type">@item.Type</span>
                    <h3>@item.Title</h3>
                    <p>@item.Subtitle</p>
                    <small>@item.Meta</small>
                </div>
            </a>
        }
    </div>
</section>
@section Scripts {
    <script>
        $(function () {
            let currentType = "all";

            function loadLibraryItems() {
                const term = $("#librarySearch").val() || "";

                $.ajax({
                    url: "/Library/Search",
                    method: "GET",
                    data: {
                        term: term,
                        type: currentType
                    },
                    success: function (data) {
                        let html = "";

                        data.forEach(function (item) {
                            html += `
                                <a href="${item.url}" class="library-card">
                                    <img src="${item.imagePath}"
                                         alt="${item.title}"
                                         onerror="this.src='/images/albums/placeholder.jpg'" />

                                    <div class="library-card-body">
                                        <span class="library-type">${item.type}</span>
                                        <h3>${item.title}</h3>
                                        <p>${item.subtitle}</p>
                                        <small>${item.meta}</small>
                                    </div>
                                </a>`;
                        });

                        if (html === "") {
                            html = `<p class="empty-search-message">No results found.</p>`;
                        }

                        $("#libraryGrid").html(html);

                        if (term.length > 0 || currentType !== "all") {
                            $("#favoriteSongsSection").hide();
                        } else {
                            $("#favoriteSongsSection").show();
                        }
                    },
                    error: function () {
                        console.log("Library search failed.");
                    }
                });
            }

            $("#librarySearch").on("input", function () {
                loadLibraryItems();

                const results = document.getElementById("libraryResultsSection");

                if (results) {
                    results.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }
            });

            $(".library-filter").on("click", function () {
                $(".library-filter").removeClass("active");
                $(this).addClass("active");

                currentType = $(this).data("type");
                loadLibraryItems();

                const results = document.getElementById("libraryResultsSection");

                if (results) {
                    results.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }
            });
        });
    </script>
}