@model string

<div class="datetime-control">
    <label>@ViewData["Label"]</label>
    <input type="text"
           name="@ViewData["Name"]"
           value="@Model"
           class="mb-input js-datepicker"
           placeholder="dd.MM.yyyy HH:mm"
           autocomplete="off" />
    <small class="form-hint">Format: dd.MM.yyyy HH:mm</small>
</div>
