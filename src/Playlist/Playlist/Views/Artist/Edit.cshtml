@model Artist
@using Playlist.Models

@{
    ViewData["Title"] = "Edit Artist";
}

<div class="admin-page">
<aside class="admin-aside">
    <div class="admin-aside-card">
        <div class="admin-aside-icon">✏️</div>
        <h3>@Model.StageName</h3>
        <p>@Model.Country · @(Model.IsActive ? "Active" : "Inactive")</p>
    </div>
    <nav class="admin-aside-links">
        <a asp-action="Details" asp-route-id="@Model.ArtistId">← Back to artist</a>
        <a asp-action="Index">All Artists</a>
    </nav>
</aside>

<form asp-action="Edit" asp-route-id="@Model.ArtistId" method="post" class="account-form crud-form fade-in-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ArtistId" />

    <div class="form-row-2">
        <div class="form-group">
            <label asp-for="StageName">Stage Name</label>
            <input asp-for="StageName" class="mb-input" />
            <span asp-validation-for="StageName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Country">Country</label>
            <input asp-for="Country" class="mb-input" />
            <span asp-validation-for="Country" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        @{
            var debutDateStr = Model.DebutDate == default ? "" : Model.DebutDate.ToString("dd.MM.yyyy");
        }
        @await Html.PartialAsync("_DateTimePicker", debutDateStr,
            new ViewDataDictionary(ViewData) { { "Label", "Debut Date" }, { "Name", "DebutDateInput" } })
        <input type="hidden" asp-for="DebutDate" id="DebutDateHidden" />
    </div>

    <div class="form-group">
        <label asp-for="Biography">Biography</label>
        <textarea asp-for="Biography" class="mb-input" rows="5"></textarea>
        <span asp-validation-for="Biography" class="text-danger"></span>
    </div>

    <div class="playlist-visibility-box">
        <label class="mb-checkbox">
            <input asp-for="IsActive" />
            <div>
                <strong>Active artist</strong>
                <p>This artist is currently active and releasing music.</p>
            </div>
        </label>
    </div>

    <div class="playlist-create-actions">
        <button type="submit" class="mb-btn mb-btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.ArtistId" class="mb-btn mb-btn-ghost">Cancel</a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $(".js-datepicker").on("change", function () {
                if ($(this).attr("name") === "DebutDateInput") {
                    $("#DebutDateHidden").val($(this).val());
                }
            });
        });
    </script>
}
