@model global::Playlist.Models.Playlist
@using System.Text.Json

@{
    ViewData["Title"] = Model.Name;

    int h = ((Model.Name.GetHashCode() % 360) + 360) % 360;
    string grad = $"linear-gradient(135deg, hsl({h},62%,20%), hsl({(h + 45) % 360},55%,12%))";

    string SongJson(global::Playlist.Models.Song s) => JsonSerializer.Serialize(new {
        id         = s.SongId,
        title      = s.Title,
        artist     = s.Artist?.StageName ?? "",
        audioUrl   = s.AudioUrl ?? "",
        coverColor = "#ff8a1f"
    });

    var queueJson = JsonSerializer.Serialize(Model.Songs.Select(s => new {
        id         = s.SongId,
        title      = s.Title,
        artist     = s.Artist?.StageName ?? "",
        audioUrl   = s.AudioUrl ?? "",
        coverColor = "#ff8a1f"
    }));
}

<section class="playlist-hero">
    <div class="playlist-cover">
        <div class="album-cover-wrap" style="background:@grad">
            <span class="album-cover-letter" style="font-size:5rem">@Model.Name.Substring(0, 1).ToUpper()</span>
        </div>
    </div>

    <div class="playlist-info">
        <p class="mb-eyebrow">Playlist</p>
        <h1>@Model.Name</h1>

        <p class="playlist-owner">
            Created by
            <a asp-controller="Account" asp-action="Profile" asp-route-id="@Model.Owner.UserId">
                @Model.Owner.Username
            </a>
        </p>

        <div class="playlist-meta">
            <span>@(Model.IsPublic ? "Public" : "Private")</span>
            <span>@Model.Songs.Count songs</span>
            <span>@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
        </div>

        <div class="record-actions">
            @if (Model.Songs.Any())
            {
                <button type="button" class="mb-btn mb-btn-primary js-play-all-btn" data-queue="@queueJson">
                    <span class="eq-bars" style="margin-right:0.25rem"><span></span><span></span><span></span><span></span></span>
                    ▶ Play Playlist
                </button>
            }
            <a asp-controller="Playlist" asp-action="Edit" asp-route-id="@Model.PlaylistId" class="mb-btn mb-btn-ghost">
                Edit
            </a>
            <a asp-controller="Library" asp-action="Index" class="mb-btn mb-btn-ghost">
                Library
            </a>
        </div>

        <form asp-controller="Playlist" asp-action="Delete" asp-route-id="@Model.PlaylistId" method="post"
              onsubmit="return confirm('Delete this playlist?');" class="mt-3">
            @Html.AntiForgeryToken()
            <button type="submit" class="mb-btn mb-btn-danger">Delete Playlist</button>
        </form>
    </div>
</section>

<section class="record-tracklist">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Tracklist</p>
            <h2>Songs in this playlist</h2>
        </div>
    </div>

    @if (Model.Songs != null && Model.Songs.Any())
    {
        <div class="tracklist">
            @{ int index = 1; }
            @foreach (var song in Model.Songs)
            {
                <article class="track-row" data-song-id="@song.SongId">
                    <div class="track-num-play">
                        <span class="track-number">@index</span>
                        <span class="eq-bars"><span></span><span></span><span></span><span></span></span>
                        <button type="button" class="js-play-btn track-play-btn" data-song="@SongJson(song)">▶</button>
                    </div>

                    <div class="track-main">
                        <h3>
                            <a asp-controller="Song" asp-action="Details" asp-route-id="@song.SongId" class="track-details-link">
                                @song.Title
                            </a>
                        </h3>
                        <p>@song.Artist.StageName · @song.Genre.Name</p>
                    </div>

                    <span class="track-duration">@song.Duration</span>

                    <form asp-controller="Playlist" asp-action="RemoveSong" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="playlistId" value="@Model.PlaylistId" />
                        <input type="hidden" name="songId" value="@song.SongId" />
                        <button type="submit" class="danger-link">Remove</button>
                    </form>
                </article>
                index++;
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <p class="mb-muted">No songs in this playlist yet.</p>
            <a asp-controller="Discover" asp-action="Index" class="mb-btn mb-btn-ghost mt-3">Browse songs</a>
        </div>
    }
</section>

    <section class="record-attachments mt-5">
        <div class="mb-section-header">
            <div>
                <p class="mb-eyebrow">Attachments</p>
                <h2>Playlist files</h2>
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Manager")))
        {
            <div class="attachment-upload-box mb-4">
                <label for="playlistFileUpload" class="mb-input-label">Upload one or more files</label>
                <input id="playlistFileUpload" type="file" multiple class="mb-input" />
                <button type="button" class="mb-btn mb-btn-primary mt-3" onclick="uploadAttachments()">Upload</button>
                <p class="mb-muted mt-2">Files are stored on the server and metadata is saved to the playlist.</p>
            </div>
        }

        <div id="attachmentList"></div>
    </section>

    <div class="details-actions mt-4">
        <a asp-controller="Home" asp-action="Index" class="mb-btn mb-btn-ghost">Home</a>
        <a asp-controller="Library" asp-action="Index" class="mb-btn mb-btn-ghost">Library</a>
        <a asp-controller="Discover" asp-action="Index" class="mb-btn mb-btn-ghost">Discover</a>
    </div>

@section Scripts {
    <script>
        const playlistId = @Model.PlaylistId;

        async function loadAttachments() {
            const response = await fetch(`/Playlist/GetAttachments?playlistId=${playlistId}`);
            if (response.ok) {
                const html = await response.text();
                document.getElementById('attachmentList').innerHTML = html;
            }
        }

        async function uploadAttachments() {
            const input = document.getElementById('playlistFileUpload');
            if (!input.files.length) {
                return;
            }

            for (const file of input.files) {
                const formData = new FormData();
                formData.append('file', file);
                formData.append('playlistId', playlistId);

                await fetch('/Playlist/UploadAttachment', {
                    method: 'POST',
                    body: formData
                });
            }

            input.value = '';
            await loadAttachments();
        }

        async function deleteAttachment(id) {
            const response = await fetch('/Playlist/DeleteAttachment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `id=${id}`
            });

            if (response.ok) {
                await loadAttachments();
            }
        }

        document.addEventListener('DOMContentLoaded', loadAttachments);
    </script>
}
