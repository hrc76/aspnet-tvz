@model global::Playlist.Models.Playlist

@{
    ViewData["Title"] = Model.Name;
    string coverName = Model.Name.Replace(" ", "") + ".jpg";
}

<section class="playlist-hero">
    <div class="playlist-cover">
        <img src="~/images/playlists/@coverName"
             alt="@Model.Name cover"
             onerror="this.src='/images/albums/placeholder.jpg'" />
    </div>

    <div class="playlist-info">
        <p class="mb-eyebrow">Playlist</p>

        <h1>@Model.Name</h1>

        <p class="playlist-owner">
            Created by
            <a asp-controller="Account"
                asp-action="Profile"
                asp-route-id="@Model.Owner.UserId">
                @Model.Owner.Username
            </a>
        </p>

        <div class="playlist-meta">
            <span>@(Model.IsPublic ? "Public" : "Private")</span>
            <span>@Model.Songs.Count songs</span>
        </div>

        <div class="record-actions">
    <button type="button" class="mb-btn mb-btn-primary">
    Play Playlist
    </button>   

    <a asp-controller="Playlist"
       asp-action="Edit"
       asp-route-id="@Model.PlaylistId"
       class="mb-btn mb-btn-ghost">
        Edit Playlist
    </a>

    <a asp-controller="Library"
       asp-action="Index"
       class="mb-btn mb-btn-ghost">
        Back to Library
    </a>
</div>

        <form asp-controller="Playlist"
              asp-action="Delete"
              asp-route-id="@Model.PlaylistId"
              method="post"
              onsubmit="return confirm('Are you sure you want to delete this playlist?');"
              class="mt-3">
            @Html.AntiForgeryToken()

            <button type="submit" class="mb-btn mb-btn-danger">
                Delete Playlist
            </button>
        </form>
    </div>
</section>

<section class="record-tracklist">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Tracklist</p>
            <h2>Songs in this playlist</h2>
        </div>
    </div>

    @if (Model.Songs != null && Model.Songs.Any())
    {
        <div class="tracklist">
            @{
                var index = 1;
            }

            @foreach (var song in Model.Songs)
            {
                <div class="track-row">
                    <span class="track-number">@index</span>

                    <div class="track-main">
                        <h3>
                            <a asp-controller="Song"
                               asp-action="Details"
                               asp-route-id="@song.SongId">
                                @song.Title
                            </a>
                        </h3>
                        <p>@song.Artist.StageName · @song.Genre.Name</p>
                    </div>

                    <span class="track-duration">@song.Duration</span>

                    <form asp-controller="Playlist"
                          asp-action="RemoveSong"
                          method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="playlistId" value="@Model.PlaylistId" />
                        <input type="hidden" name="songId" value="@song.SongId" />

                        <button type="submit" class="danger-link">
                            Remove
                        </button>
                    </form>
                </div>

                index++;
            }
        </div>
    }
    else
    {
        <p>No songs in this playlist.</p>
    }
</section>

<p class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="mb-btn mb-btn-ghost">Home</a>
    <a asp-controller="Library" asp-action="Index" class="mb-btn mb-btn-ghost">Library</a>
    <a asp-controller="Discover" asp-action="Index" class="mb-btn mb-btn-ghost">Discover</a>
</p>