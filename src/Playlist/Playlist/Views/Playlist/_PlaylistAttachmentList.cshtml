@model IEnumerable<global::Playlist.Models.PlaylistAttachment>

<div class="playlist-attachment-list mt-5">
    <h3>Uploaded files</h3>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <p class="mb-muted">No files uploaded for this playlist yet.</p>
        </div>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Size</th>
                    <th>Uploaded</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attachment in Model)
                {
                    <tr>
                        <td>
                            <a href="@attachment.FilePath" target="_blank">@attachment.FileName</a>
                        </td>
                        <td>@(attachment.FileSize / 1024) KB</td>
                        <td>@attachment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm" onclick="deleteAttachment(@attachment.ID)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
