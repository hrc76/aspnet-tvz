@model global::Playlist.Models.Playlist

@{
    ViewData["Title"] = "Create Playlist";
}

<div class="admin-page">
<aside class="admin-aside">
    <div class="admin-aside-card">
        <div class="admin-aside-icon">🎧</div>
        <h3>New Playlist</h3>
        <p>Create a public or private playlist. After saving, open it from Library to add songs.</p>
    </div>
    <nav class="admin-aside-links">
        <a asp-controller="Library" asp-action="Index">← Back to Library</a>
        <a asp-controller="Playlist" asp-action="Index">All Playlists</a>
    </nav>
</aside>

<form asp-controller="Playlist"
      asp-action="Create"
      method="post"
      class="account-form playlist-create-form">

    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="Name">Playlist name</label>

        <input asp-for="Name"
               class="mb-input"
               placeholder="Late Night Drive" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description">Description</label>

        <textarea asp-for="Description"
                  class="mb-input"
                  rows="5"
                  placeholder="Describe the vibe of this playlist..."></textarea>

        <span asp-validation-for="Description"
              class="text-danger"></span>
    </div>

    <div class="playlist-visibility-box">
        <label class="mb-checkbox">
            <input asp-for="IsPublic" />

            <div>
                <strong>Public playlist</strong>
                <p>Other users can see this playlist.</p>
            </div>
        </label>
    </div>

    <div class="playlist-create-actions">
        <button type="submit" class="mb-btn mb-btn-primary">Create Playlist</button>
        <a asp-controller="Library" asp-action="Index" class="mb-btn mb-btn-ghost">Cancel</a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}