@model global::Playlist.Models.Playlist

@{
    ViewData["Title"] = "Edit Playlist";
}

<section class="library-hero">
    <p class="mb-eyebrow">Edit playlist</p>

    <h1>@Model.Name</h1>

    <p>Update playlist name, description and visibility.</p>
</section>

<form asp-controller="Playlist"
      asp-action="Edit"
      asp-route-id="@Model.PlaylistId"
      method="post"
      class="account-form playlist-create-form">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PlaylistId" />

    <div class="form-group">
        <label asp-for="Name">Playlist name</label>

        <input asp-for="Name"
               class="mb-input" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description">Description</label>

        <textarea asp-for="Description"
                  class="mb-input"
                  rows="5"></textarea>

        <span asp-validation-for="Description"
              class="text-danger"></span>
    </div>

    <div class="playlist-visibility-box">
        <label class="mb-checkbox">
            <input asp-for="IsPublic" />

            <div>
                <strong>Public playlist</strong>
                <p>Other users can see this playlist.</p>
            </div>
        </label>
    </div>

    <div class="playlist-create-actions">
        <button type="submit" class="mb-btn mb-btn-primary">
            Save Changes
        </button>

        <a asp-controller="Playlist"
           asp-action="Details"
           asp-route-id="@Model.PlaylistId"
           class="mb-btn mb-btn-ghost">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}