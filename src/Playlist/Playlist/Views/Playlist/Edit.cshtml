@model global::Playlist.Models.Playlist

@{
    ViewData["Title"] = "Edit Playlist";
}

<div class="admin-page">
<aside class="admin-aside">
    <div class="admin-aside-card">
        <div class="admin-aside-icon">✏️</div>
        <h3>@Model.Name</h3>
        <p>@(Model.IsPublic ? "Public" : "Private") · @Model.Songs?.Count songs</p>
    </div>
    <nav class="admin-aside-links">
        <a asp-controller="Playlist" asp-action="Details" asp-route-id="@Model.PlaylistId">← Back to playlist</a>
        <a asp-controller="Playlist" asp-action="Index">All Playlists</a>
    </nav>
</aside>

<form asp-controller="Playlist"
      asp-action="Edit"
      asp-route-id="@Model.PlaylistId"
      method="post"
      enctype="multipart/form-data"
      class="account-form playlist-create-form">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PlaylistId" />
    <input type="hidden" asp-for="CoverImageUrl" />

    <div class="form-group">
        <label asp-for="Name">Playlist name</label>

        <input asp-for="Name"
               class="mb-input" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description">Description</label>

        <textarea asp-for="Description"
                  class="mb-input"
                  rows="5"></textarea>

        <span asp-validation-for="Description"
              class="text-danger"></span>
    </div>

    <div class="playlist-visibility-box">
        <label class="mb-checkbox">
            <input asp-for="IsPublic" />

            <div>
                <strong>Public playlist</strong>
                <p>Other users can see this playlist.</p>
            </div>
        </label>
    </div>

    <div class="form-group image-upload-field js-image-upload">
        <label for="coverImage">Playlist cover</label>
        <input type="hidden" name="removeCoverImage" value="false" data-remove-image-input />
        <div class="image-upload-preview-shell @(string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "is-empty" : "")" data-image-preview-shell>
            <img src="@Model.CoverImageUrl" class="image-upload-preview" data-image-preview alt="Playlist cover preview" />
            <button type="button" class="image-remove-button" data-image-remove aria-label="Remove playlist cover" title="Remove image">X</button>
            <span class="image-preview-label">@(string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "READY TO UPLOAD" : "CURRENT IMAGE")</span>
        </div>
        <input id="coverImage" name="coverImage" type="file"
               accept="image/jpeg,image/png,image/webp" class="mb-input" data-image-input />
        <span class="text-danger">@Html.ValidationMessage("coverImage")</span>
        <small>Leave empty to keep the current image. JPG, PNG or WebP, maximum 5 MB.</small>
    </div>

    <div class="playlist-create-actions">
        <button type="submit" class="mb-btn mb-btn-primary">Save Changes</button>
        <a asp-controller="Playlist" asp-action="Details" asp-route-id="@Model.PlaylistId" class="mb-btn mb-btn-ghost">Cancel</a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
