@model User
@using Playlist.Models

@{
    ViewData["Title"] = Model.Username;
}

<section class="artist-profile-hero">
    <div class="artist-avatar">
        <span>@Model.Username.Substring(0, 1).ToUpper()</span>
    </div>
    <div class="artist-profile-info">
        <p class="mb-eyebrow">User</p>
        <h1>
            @Model.Username
            @if (Model.IsPremium)
            {
                <span class="premium-badge">Premium</span>
            }
        </h1>
        <div class="artist-meta-row">
            <span>@Model.Email</span>
            <span>Joined @Model.RegistrationDate.ToString("dd.MM.yyyy")</span>
            <span>Fav. genre: @Model.FavoriteGenreName</span>
            <span>@Model.Playlists?.Count playlists</span>
        </div>
    </div>
</section>

<section class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Playlists</p>
            <h2>User Playlists</h2>
        </div>
    </div>
    @if (Model.Playlists != null && Model.Playlists.Any())
    {
        <div class="entity-list">
            @foreach (var playlist in Model.Playlists)
            {
                <article class="entity-row">
                    <div class="entity-row-main">
                        <span class="entity-row-icon">♫</span>
                        <div>
                            <h3>@playlist.Name</h3>
                            <p>@(playlist.IsPublic ? "Public" : "Private") · @playlist.Songs?.Count songs</p>
                        </div>
                    </div>
                    <div class="entity-row-actions">
                        <a asp-controller="Playlist" asp-action="Details" asp-route-id="@playlist.PlaylistId" class="mb-btn mb-btn-ghost btn-sm">Open</a>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No playlists.</p>
    }
</section>

<section class="mb-section">
    <div class="mb-section-header">
        <div>
            <p class="mb-eyebrow">Activity</p>
            <h2>Listening History</h2>
        </div>
    </div>
    @if (Model.ListeningHistory != null && Model.ListeningHistory.Any())
    {
        <div class="entity-list">
            @foreach (var h in Model.ListeningHistory.Take(10))
            {
                <article class="entity-row">
                    <div class="entity-row-main">
                        <span class="entity-row-icon">▶</span>
                        <div>
                            <h3>@h.Song.Title</h3>
                            <p>@h.Song.Artist.StageName · @h.ListenedAt.ToString("dd.MM.yyyy HH:mm") · @h.Repeats× played</p>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No listening history.</p>
    }
</section>

<div class="details-actions mt-4">
    <a asp-action="Edit" asp-route-id="@Model.UserId" class="mb-btn mb-btn-secondary">Edit User</a>
    <form asp-action="Delete" asp-route-id="@Model.UserId" method="post" class="inline-form">
        @Html.AntiForgeryToken()
        <button type="submit" class="mb-btn mb-btn-danger"
                onclick="return confirm('Delete user \'@Model.Username\'?')">Delete User</button>
    </form>
    <a asp-action="Index" class="mb-btn mb-btn-ghost">All Users</a>
    <a asp-controller="Home" asp-action="Index" class="mb-btn mb-btn-ghost">Home</a>
</div>
