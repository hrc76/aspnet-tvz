@model User
@using Playlist.Models

@{
    ViewData["Title"] = "Edit User";
}

<div class="admin-page">
<aside class="admin-aside">
    <div class="admin-aside-card">
        <div class="admin-aside-icon">✏️</div>
        <h3>@Model.Username</h3>
        <p>@Model.Email · @(Model.IsPremium ? "Premium" : "Free")</p>
    </div>
    <nav class="admin-aside-links">
        <a asp-action="Details" asp-route-id="@Model.UserId">← Back to user</a>
        <a asp-action="Index">All Users</a>
    </nav>
</aside>

<form asp-action="Edit" asp-route-id="@Model.UserId" method="post" class="account-form crud-form fade-in-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />

    <div class="form-row-2">
        <div class="form-group">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" class="mb-input" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" class="mb-input" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row-2">
        <div class="form-group">
            @{
                var regDateStr = Model.RegistrationDate == default ? "" : Model.RegistrationDate.ToString("dd.MM.yyyy");
            }
            @await Html.PartialAsync("_DateTimePicker", regDateStr,
                new ViewDataDictionary(ViewData) { { "Label", "Registration Date" }, { "Name", "RegistrationDateInput" } })
            <input type="hidden" asp-for="RegistrationDate" id="RegistrationDateHidden" />
        </div>

        <div class="form-group">
            <label asp-for="FavoriteGenreName">Favorite Genre</label>
            <input asp-for="FavoriteGenreName" class="mb-input" />
            <span asp-validation-for="FavoriteGenreName" class="text-danger"></span>
        </div>
    </div>

    <div class="playlist-visibility-box">
        <label class="mb-checkbox">
            <input asp-for="IsPremium" />
            <div>
                <strong>Premium user</strong>
                <p>This user has a premium subscription.</p>
            </div>
        </label>
    </div>

    <div class="playlist-create-actions">
        <button type="submit" class="mb-btn mb-btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.UserId" class="mb-btn mb-btn-ghost">Cancel</a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $(".js-datepicker").on("change", function () {
                if ($(this).attr("name") === "RegistrationDateInput") {
                    $("#RegistrationDateHidden").val($(this).val());
                }
            });
        });
    </script>
}
