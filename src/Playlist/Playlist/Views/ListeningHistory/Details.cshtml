@model ListeningHistory
@using Playlist.Models

@{
    ViewData["Title"] = "Listening History Details";
}

<section class="artist-profile-hero">
    <div class="entity-row-icon" style="width:3.5rem;height:3.5rem;font-size:1.6rem;border-radius:1rem;">▶</div>
    <div class="artist-profile-info">
        <p class="mb-eyebrow">Play event</p>
        <h1>@Model.Song.Title</h1>
        <div class="artist-meta-row">
            <span>by @Model.Song.Artist.StageName</span>
            <span>Played by @Model.User.Username</span>
            <span>@Model.ListenedAt.ToString("dd.MM.yyyy HH:mm")</span>
            <span>@Model.Repeats× repeats</span>
        </div>
    </div>
</section>

<section class="mb-section">
    <div class="song-context-grid">
        <article class="song-context-card">
            <p class="mb-eyebrow">User</p>
            <h2>@Model.User.Username</h2>
            <p>@Model.User.Email</p>
            <a asp-controller="User" asp-action="Details" asp-route-id="@Model.User.UserId">Open user page</a>
        </article>

        <article class="song-context-card">
            <p class="mb-eyebrow">Song</p>
            <h2>@Model.Song.Title</h2>
            <p>@Model.Song.Artist.StageName · @Model.Song.Duration</p>
            <a asp-controller="Song" asp-action="Details" asp-route-id="@Model.Song.SongId">Open song page</a>
        </article>
    </div>
</section>

<div class="details-actions mt-4">
    <a asp-action="Index" class="mb-btn mb-btn-ghost">All History</a>
    <a asp-controller="Home" asp-action="Index" class="mb-btn mb-btn-ghost">Home</a>
</div>
