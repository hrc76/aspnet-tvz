@model ListeningHistory


<h1>Listening History Details</h1>

<p>
    <strong>User:</strong>
    <a asp-controller="User" asp-action="Details" asp-route-id="@Model.User.UserId">
        @Model.User.Username
    </a>
</p>

<p>
    <strong>Song:</strong>
    <a asp-controller="Song" asp-action="Details" asp-route-id="@Model.Song.SongId">
        @Model.Song.Title
    </a>
</p>

<p><strong>Listened At:</strong> @Model.ListenedAt</p>
<p><strong>Repeats:</strong> @Model.Repeats</p>

<p class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="mb-btn mb-btn-ghost">Home</a>
    <a asp-controller="Library" asp-action="Index" class="mb-btn mb-btn-ghost">Library</a>
    <a asp-controller="Discover" asp-action="Index" class="mb-btn mb-btn-ghost">Discover</a>
</p>